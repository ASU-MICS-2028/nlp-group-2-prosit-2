# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini          # gemini now; claude later when we have credits
LLM_MODEL=                   # an exact model name, never an alias. gemini-3.5-flash worked on 2026-11-04
LLM_BACKUP_MODEL=            # optional (D-018): used for the 4th try after LLM_MODEL is busy 3 times in one build, e.g. gemini-3-flash-preview
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
