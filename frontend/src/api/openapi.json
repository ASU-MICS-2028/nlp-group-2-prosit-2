        "title": "Question"
      },
      "StartRequest": {
        "properties": {
          "request": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Request"
          }
        },
        "type": "object",
        "required": [
          "request"
        ],
        "title": "StartRequest"
      },
      "StartResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
